rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read/write only own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        // Users cannot set their own scores or evaluation fields
        && !('rating' in request.resource.data)
        && !('dimensionScores' in request.resource.data);
    }

    // Articles: authenticated users can read; only admin/server can write
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if false; // Server-side only via Admin SDK
    }

    // Attempts: users can read only their own; no client-side writes
    match /attempts/{attemptId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side only via Admin SDK
    }
  }
}
