rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: authenticated users can read and update only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Articles: authenticated users can read; authenticated users can manage their own uploads
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Attempts: users can only read their own evaluation attempts
    // Engagement data is stored as aggregated summary metrics (focus %, emotion breakdown)
    // Detailed timelines are omitted when Strict Privacy Mode is enabled
    match /attempts/{attemptId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
